# BizFlow environment template — copy to `.env` (never commit `.env`).
# See src/lib/env.ts for validation.

# PostgreSQL connection string used by Prisma.
# Example: postgresql://bizflow:bizflow@localhost:5432/bizflow?schema=public
DATABASE_URL=

# Base URL of the app (required by Auth.js in later milestones).
# Example: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Random secret for Auth.js sessions (generate with `openssl rand -base64 32`).
# Leave empty until the auth milestone wires providers.
NEXTAUTH_SECRET=
